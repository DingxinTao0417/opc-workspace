{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "opc-workspace",
  "version": "0.1.0",
  "identifier": "com.opcworkspace.desktop",
  "build": {
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "opc-workspace",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 720,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "visible": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src ipc: http://ipc.localhost http://127.0.0.1:*; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/opc-sidecar"],
    "category": "Productivity",
    "shortDescription": "Local-first workspace for one-person companies"
  }
}
